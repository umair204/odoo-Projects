<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_so_mo_tracking_document">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <h2>Manufacturing Order Tracking</h2>

                        <p t-if="doc.so_name and not doc.date_from and not doc.date_to">
                            Sale Order: <span t-esc="doc.so_name"/>
                        </p>
                        <p t-if="doc.date_from or doc.date_to">
                            Delivery Date Range:
                            <span t-esc="doc.date_from or '...'"/>
                            to
                            <span t-esc="doc.date_to or '...'"/>
                        </p>

                        <t t-foreach="doc.get_grouped_lines()" t-as="grp">
                            <h4 t-esc="grp[0]" style="margin-top: 16px;"/>
                            <table class="table table-sm o_main_table" style="margin-bottom: 24px;">
                                <thead>
                                    <tr>
                                        <th>Stage</th>
                                        <th>MO</th>
                                        <th>Product</th>
                                        <th>Status</th>
                                        <th>Qty Producing</th>
                                        <th>Qty To Produce</th>
                                        <th>Leftover</th>
                                        <th>Entry Date</th>
                                        <th>End Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="grp[1]" t-as="line">
                                        <tr>
                                            <td t-esc="line.stage"/>
                                            <td t-esc="line.mo_name"/>
                                            <td t-esc="line.product_id.display_name"/>
                                            <td t-esc="line.state_label"/>
                                            <td t-esc="line.qty_producing"/>
                                            <td t-esc="line.product_qty"/>
                                            <td t-esc="line.leftover"/>
                                            <td t-esc="line.entry_date"/>
                                            <td t-esc="line.end_date"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>