<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Appears under the "Actions" (gear) menu on Sales Orders, both in the
         list view (works on selected rows, across pagination/filters) and
         the form view (single record). -->
    <record id="action_add_to_dispatch_list" model="ir.actions.server">
        <field name="name">Add to Dispatch List</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_add_to_dispatch_list()</field>
    </record>

</odoo>