<odoo>
    <record model="ir.ui.view" id="shift_adjustment_wizard_form">
        <field name="name">Shift Adjustment</field>
        <field name="model">shift.adjustment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div role="status" class="alert alert-info" invisible="not attendance_line_ids">
                        <span>This adjustment will impact a total of &#160;&#160;&#160;</span>
                        <strong>
                            <field name="lines_count" />
                            <span>&#160;&#160;&#160;records</span>
                        </strong>
                        <span>.</span>
                    </div>
                    <sheet>

                        <div class="mb-5" invisible="adjustment_type">
                            <div class="d-flex justify-content-center">
                                <i class="fa fa-calendar-plus-o pb-1 fa-3x text-info" title="Sales Team" />
                            </div>
                            <div>
                                <h3 class=" d-flex  justify-content-center mt-2">Organise Attendance</h3>
                                <h6 class="d-flex  justify-content-center text-muted">To facilitate the attendance and shift planning</h6>
                            </div>
                        </div>

                        <div class="container d-flex justify-content-center my-2 align-items-center" invisible="adjustment_type">
                            <field name="adjustment_type" widget='selection_badge' />
                        </div>


                        <field name="avatar_1920" widget="image" class="oe_avatar" invisible="not employee_id" />
                        <div class="mb-3" invisible="not employee_id">
                            <h1 style="margin-top: 0; margin-bottom: 0; padding-bottom: 0;">
                                <field name="employee_id" readonly="1" />
                            </h1>
                            <field name="position_id" force_save="1" readonly="1" />
                            <span>
                                <i>(<field name="department_id" force_save="1" readonly="1" />) </i>
                            </span>
                            <br></br>
                            <field name="manager_id" force_save="1" widget="many2one_avatar" readonly="1" />
                        </div>


                        <div invisible="not adjustment_type">
                            <p invisible="adjustment_type == 'unrecorded_attendance'" class="text-info">You are about to change shift of existing attendance.</p>
                            <p invisible="adjustment_type == 'adjust_shift'" class="text-danger">You are about to create unrecorded attendance.</p>
                        </div>

                        <group invisible="not adjustment_type">
                            <group>
                                <field name="employee_id" options="{'no_create': True, 'no_open': True}" />
                                <field name="shift_id" options="{'no_create': True, 'no_open': True}" />
                                <!--                                <field name="selected_field"/>-->
                            </group>
                            <group>
                                <field name="rest_days_ids" widget="many2many_tags" />
                                <div colspan="2">
                                    <field name="start_date" string="Pick Dates" placeholder="Select Date Range!"
                                        widget="daterange"
                                        options="{'end_date_field': 'end_date'}" />
                                    <field name="end_date" invisible="1" />
                                </div>
                            </group>
                        </group>


                        <field name="attendance_line_ids" invisible="not attendance_line_ids " widget="one2many"
                            readonly="1" force_save="1">
                            <tree>
                                <field name="shift_adjustment_id" column_invisible="1" />
                                <field name="employee_id" force_save="1" />
                                <field name="check_in_status" force_save="1" />
                                <field name="check_out_status" force_save="1" />
                                <field name="check_in" widget="datetime" force_save="1" />
                                <field name="check_out" widget="datetime" force_save="1" />
                                <field name="employee_shift_id" force_save="1" />
                            </tree>
                            <form>
                                <group>
                                    <group>
                                        <field name="shift_adjustment_id" invisible="1" />
                                        <field name="employee_id" force_save="1" />
                                        <field name="check_in_status" force_save="1" />
                                        <field name="check_out_status" force_save="1" />
                                    </group>
                                    <group>
                                        <field name="check_in" widget="datetime" force_save="1" />
                                        <field name="check_out" widget="datetime" force_save="1" />
                                        <field name="employee_shift_id" force_save="1" />
                                    </group>
                                </group>
                            </form>

                        </field>


                    </sheet>
                </sheet>
                <footer>
                    <button string="Correct Now!"
                        type="object"
                        name="action_adjust_now"
                        confirm="Do you want to correct records now?"
                        confirm-title="Ready for correction?"
                        confirm-label="Yes Please!"
                        class="btn btn-primary" />

                    <button string="Close"
                        type="object"
                        name="action_reset"
                        class="btn btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="shift_adjustment_wizard">
        <field name="name">Attendance Correction</field>
        <field name="res_model">shift.adjustment</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="shift_adjustment_wizard_form" />
        <field name="target">new</field>
    </record>

    <!-- actions -->
    <menuitem name="Operations" id="operation_menu_item" parent="hr_attendance.menu_hr_attendance_root"
        groups="hr.group_hr_user" sequence="5" />
    <menuitem name="Attendance Correction" id="shift_adjustment_menu_item" parent="hr_zk_attendance.operation_menu_item"
        groups="hr_zk_attendance.groups_shift_adjmnt_data_rights" action="shift_adjustment_wizard" sequence="5" />

</odoo>