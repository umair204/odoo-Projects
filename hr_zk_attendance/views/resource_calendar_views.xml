<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- View resource.calendar form -->
  <record id="view_resource_calendar_form" model="ir.ui.view">
    <field name="name">view.resource.calendar.form</field>
    <field name="model">resource.calendar</field>
    <field name="inherit_id" ref="resource.resource_calendar_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='company_id']"
        position="before">
        <field name="shift_start" placeholder='e.g 9:00'
          widget="float_time"
          required="1"
        />
        <field name="shift_end" placeholder='e.g 18:00'
          required="1"
          widget="float_time"
        />
      </xpath>
    </field>
  </record>

</odoo>