<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View hr.rest_day View Tree -->
    <record id="view_hr_rest_day_tree" model="ir.ui.view">
        <field name="name">view.hr.rest_day.tree</field>
        <field name="model">hr.rest_day</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View hr.rest_day form -->
    <record id="view_hr_rest_day_form" model="ir.ui.view">
        <field name="name">view.hr.rest_day.form</field>
        <field name="model">hr.rest_day</field>
        <field name="arch" type="xml">
            <form string="Hr Rest_day">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View hr.rest_day search -->
    <record id="view_hr_rest_day_search" model="ir.ui.view">
        <field name="name">view.hr.rest_day.search</field>
        <field name="model">hr.rest_day</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action hr.rest_day -->
    <record id="action_hr_rest_day" model="ir.actions.act_window">
        <field name="name">Hr Rest_day</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.rest_day</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Hr Rest_day.
            </p>
        </field>
    </record>

</odoo>
